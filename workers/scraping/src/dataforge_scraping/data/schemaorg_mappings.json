        "name": "hiringOrganization.name",
        "url": "url",
        "date_posted": "datePosted",
        "valid_through": "validThrough",
        "employment_type": "employmentType",
        "city": "jobLocation.address.addressLocality",
        "state": "jobLocation.address.addressRegion",
        "postal_code": "jobLocation.address.postalCode",
        "country": "jobLocation.address.addressCountry",
        "salary_min": "baseSalary.value.minValue",
        "salary_max": "baseSalary.value.maxValue",
        "salary_currency": "baseSalary.currency",
        "identifier": "identifier.value"
      }
    },
    "RealEstateListing": {
      "entity": "property",
      "includes_subtypes": [
        "Residence",
        "SingleFamilyResidence",
        "Apartment",
        "House",
        "Accommodation"
      ],
      "fields": {
        "name": "name",
        "url": "url",
        "address": "address.streetAddress",
        "city": "address.addressLocality",
        "state": "address.addressRegion",
        "postal_code": "address.postalCode",
        "price": "offers.price",
        "price_currency": "offers.priceCurrency",
