{
  "schema_version": 1,
  "notes": "schema.org type -> DataForge record fields. Paths use dots; lists take their first element. Field names match the matching roles proposed on import.",
  "types": {
    "LocalBusiness": {
      "entity": "business",
      "includes_subtypes": [
        "Restaurant",
        "Store",
        "ProfessionalService",
        "RealEstateAgent",
        "AutomotiveBusiness",
        "HealthAndBeautyBusiness",
        "HomeAndConstructionBusiness",
        "LodgingBusiness",
        "FoodEstablishment",
        "Dentist",
        "MedicalBusiness",
        "LegalService",
        "FinancialService",
        "Hotel",
        "BarOrPub",
        "CafeOrCoffeeShop",
        "AutoDealer",
        "AutoRepair",
        "Plumber",
        "Electrician",
        "HVACBusiness",
        "RoofingContractor",
        "GeneralContractor",
        "Attorney",
        "AccountingService",
        "InsuranceAgency",
        "BankOrCreditUnion",
        "Pharmacy",
        "Physician",
        "VeterinaryCare",
        "ChildCare",
        "GroceryStore",
        "ClothingStore",
        "HardwareStore",
        "HomeGoodsStore",
        "FurnitureStore",
        "ElectronicsStore",
        "BookStore",
        "ShoppingCenter",
        "SportsActivityLocation",
        "ExerciseGym",
        "TravelAgency",
        "EmploymentAgency",
        "MovingCompany",
        "SelfStorage",
        "LodgingBusiness"
      ],
      "fields": {
        "name": "name",
        "phone": "telephone",
        "email": "email",
        "url": "url",
        "address": "address.streetAddress",
        "city": "address.addressLocality",
        "state": "address.addressRegion",
        "postal_code": "address.postalCode",
        "country": "address.addressCountry",
        "latitude": "geo.latitude",
        "longitude": "geo.longitude",
        "rating": "aggregateRating.ratingValue",
        "review_count": "aggregateRating.reviewCount",
        "price_range": "priceRange",
        "identifier": "@id"
      }
    },
    "Organization": {
      "entity": "business",
      "includes_subtypes": [
        "Corporation",
        "NGO",
        "EducationalOrganization",
        "GovernmentOrganization",
        "NewsMediaOrganization"
      ],
      "fields": {
        "name": "name",
        "phone": "telephone",
        "email": "email",
        "url": "url",
        "logo": "logo",
        "address": "address.streetAddress",
        "city": "address.addressLocality",
        "state": "address.addressRegion",
        "postal_code": "address.postalCode",
        "country": "address.addressCountry",
        "identifier": "@id"
      }
    },
    "Product": {
      "entity": "product",
      "includes_subtypes": [
        "IndividualProduct",
        "ProductModel",
        "Vehicle",
        "Car",
        "ProductGroup",
        "SomeProducts"
      ],
      "fields": {
        "name": "name",
        "sku": "sku",
        "gtin": "gtin13",
        "mpn": "mpn",
        "brand": "brand.name",
        "url": "url",
        "image": "image",
        "description": "description",
        "price": "offers.price",
        "price_currency": "offers.priceCurrency",
        "low_price": "offers.lowPrice",
        "availability": "offers.availability",
        "rating": "aggregateRating.ratingValue",
        "review_count": "aggregateRating.reviewCount",
        "identifier": "@id"
      }
    },
    "JobPosting": {
      "entity": "job",
      "fields": {
