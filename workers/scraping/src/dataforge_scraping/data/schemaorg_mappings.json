        "OpinionNewsArticle",
        "AnalysisNewsArticle",
        "ReportageNewsArticle",
        "ReviewNewsArticle",
        "BackgroundNewsArticle",
        "SocialMediaPosting",
        "DiscussionForumPosting",
        "MedicalScholarlyArticle",
        "SatiricalArticle"
      ],
      "fields": {
        "title": "headline",
        "name": "name",
        "author": "author.name",
        "publisher": "publisher.name",
        "date_published": "datePublished",
        "date_modified": "dateModified",
        "url": "url",
        "image": "image",
        "description": "description",
        "identifier": "@id"
      }
    },
    "Event": {
      "entity": "event",
      "includes_subtypes": [
        "MusicEvent",
        "SportsEvent",
        "BusinessEvent",
        "EducationEvent"
