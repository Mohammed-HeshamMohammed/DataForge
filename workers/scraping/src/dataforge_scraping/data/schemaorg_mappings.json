      "fields": {
        "name": "name",
        "start_date": "startDate",
        "end_date": "endDate",
        "url": "url",
        "venue": "location.name",
        "address": "location.address.streetAddress",
        "city": "location.address.addressLocality",
        "state": "location.address.addressRegion",
        "postal_code": "location.address.postalCode",
        "price": "offers.price",
        "organizer": "organizer.name",
        "identifier": "@id"
      }
