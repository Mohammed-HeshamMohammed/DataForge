    "Book": {
      "entity": "product",
      "fields": {
        "name": "name",
        "author": "author.name",
        "isbn": "isbn",
        "url": "url",
        "price": "offers.price",
        "price_currency": "offers.priceCurrency",
        "identifier": "@id"
      }
    }
