{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dataforge.local/contracts/preset.schema.json",
  "title": "WebsitePreset",
  "description": "Structural contract; semantic rules are enforced by dataforge_scraping.presets.validate_preset.",
  "type": "object",
  "required": [
    "id",
    "version",
    "display_name",
    "category",
    "page_type",
    "url_scope",
    "policy",
    "strategy",
    "request_limits",
    "extraction"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "active",
        "degraded",
        "deprecated",
        "disabled"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "requires_user_authorization_acknowledgement"
      ],
      "properties": {
        "requires_user_authorization_acknowledgement": {
          "const": true
        },
        "authentication": {
          "const": "forbidden"
        },
        "purpose": {
          "enum": [
            "internal_analysis",
            "lead_research",
            "dataset_building",
            "price_monitoring",
            "research",
            "archival",
            "search_indexing",
            "ai_training"
          ]
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": [
        "preferred"
      ],
      "properties": {
        "preferred": {
          "enum": [
            "api",
            "http",
            "webview"
          ]
        }
      }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "none",
            "next_link",
            "page_parameter",
            "cursor",
            "infinite_scroll",
            "api_cursor",
            "detail_links"
          ]
        }
      }
    },
    "engine": {
      "enum": [
        "auto",
        "httpx",
        "scrapy"
      ]
    },
    "requires_contact_user_agent": {
      "type": "boolean"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "sitemap",
            "feed",
            "crawl",
            "llms_txt"
          ]
        },
        "crawl": {
          "type": "object",
          "properties": {
            "max_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "same_host_only": {
              "const": true
            }
          }
        },
        "sitemap": {
          "type": "object"
        },
        "feed": {
          "type": "object"
        },
        "llms_txt": {
          "type": "object"
        },
        "file_links": {
          "type": "boolean"
        },
        "max_files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "request": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "url_template": {
          "type": "string",
          "pattern": "^https://"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "enum",
                  "sparql",
                  "path"
                ]
              }
            }
          }
        }
      }
    },
    "extraction": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "selectors",
            "structured_data",
            "article",
            "document_tables",
            "api"
          ]
        }
      }
    }
  }
}
