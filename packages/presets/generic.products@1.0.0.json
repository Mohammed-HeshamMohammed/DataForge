{
  "id": "generic.products",
  "version": "1.0.0",
  "display_name": "Products (built-in collector)",
  "page_type": "category_listing",
  "description": "One record per product on Amazon search result pages, read in Scrape Studio from the result cards: ASIN, title, brand, price, list price, rating, rating count, badge, sponsored flag, position, image and product link.",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-04-01",
  "provider": {
    "name": "Generic"
  },
  "category": "generic",
  "policy": {
    "collection_basis": "public_html",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "public_metadata",
    "notes": "Product facts shown on search results. Use only for data you are authorized to collect and process."
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 8000,
    "max_pages_default": 200,
    "max_records_default": 50000,
    "max_duration_seconds": 14400
  },
  "url_scope": {
    "allowed_hosts": [],
    "user_supplied_host": true,
    "allowed_path_patterns": []
  },
  "strategy": {
    "preferred": "webview",
    "allowed": [
      "webview"
    ],
    "prohibited_escalations": [
      "access_denied",
      "captcha",
      "login_required",
      "robots_disallowed"
    ]
  },
  "extraction": {
    "mode": "collector",
    "collector": "products",
    "fields": [
      {
        "key": "asin",
        "type": "string",
        "required": true,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "title",
        "type": "string",
        "required": true,
        "transforms": [
          "trim",
          "collapse_whitespace"
        ]
      },
      {
        "key": "brand",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "price",
        "type": "decimal",
        "required": false
      },
      {
        "key": "currency",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "list_price",
        "type": "decimal",
        "required": false
      },
      {
        "key": "rating",
        "type": "decimal",
        "required": false
      },
      {
        "key": "ratings_count",
        "type": "integer",
        "required": false
      },
      {
        "key": "badge",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "sponsored",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "page",
        "type": "integer",
        "required": false
      },
      {
        "key": "position",
        "type": "integer",
        "required": false
      },
      {
        "key": "image",
        "type": "url",
        "required": false,
        "transforms": [
          "to_absolute_url"
        ]
      },
      {
        "key": "product_url",
        "type": "url",
        "required": false,
        "transforms": [
          "to_absolute_url"
        ]
      },
      {
        "key": "site",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "delivery",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "seller",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "fulfilled_by",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "availability",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "category_path",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "best_sellers_rank",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "about_this_item",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "product_details",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "features_specs",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "additional_details",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "product_description",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "from_the_manufacturer",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "all_images",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "details_json",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "details_collected_at",
        "type": "string",
        "required": false,
        "transforms": [
          "trim"
        ]
      }
    ]
  },
  "pagination": {
    "type": "none"
  },
  "validation": {
    "minimum_record_coverage": 0.7,
    "unique_by": [
      "asin"
    ]
  },
  "field_mappings": {
    "canonical_entity": "custom",
    "output": {
      "title": "title",
      "price": "price",
      "source_url": "product_url"
    }
  },
  "health": {
    "fixture_tests": [
      "fixtures/collector/products.json"
    ],
    "expected": {
      "minimum_records": 2,
      "required_field_coverage": 1.0
    }
  }
}
