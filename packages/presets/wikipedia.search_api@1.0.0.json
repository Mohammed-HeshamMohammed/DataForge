{
  "id": "wikipedia.search_api",
  "version": "1.0.0",
  "display_name": "Wikipedia — Search (MediaWiki API)",
  "category": "news_community",
  "provider": {
    "name": "Wikipedia",
    "homepage": "https://www.wikipedia.org/",
    "api_docs": "https://www.mediawiki.org/wiki/API:Search"
  },
  "page_type": "api_collection",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-03-01",
  "description": "One record per search result from the documented MediaWiki search API. Start URL example: https://en.wikipedia.org/w/api.php?action=query&list=search&srsearch=data&format=json",
  "url_scope": {
    "allowed_hosts": [
      "en.wikipedia.org"
    ],
    "allowed_path_patterns": [
      "^/w/api\\.php$"
    ]
  },
  "policy": {
    "collection_basis": "public_api",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "limited",
    "notes": "Documented public API. Follow the provider's API terms and rate limits; use only for data you are authorized to process."
  },
  "strategy": {
    "preferred": "api",
    "allowed": [
      "api"
    ],
    "api_integration": null
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 1000,
    "max_pages_default": 5,
    "max_records_default": 200,
    "max_duration_seconds": 300
  },
  "extraction": {
    "item_path": "query.search",
    "fields": [
      {
        "key": "title",
        "type": "string",
        "required": true,
        "path": "title",
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "page_id",
        "type": "string",
        "required": true,
        "path": "pageid"
      },
      {
        "key": "snippet",
        "type": "string",
        "path": "snippet",
        "transforms": [
          "strip_html"
        ]
      },
      {
        "key": "word_count",
        "type": "integer",
        "path": "wordcount"
      },
      {
        "key": "last_edited",
        "type": "string",
        "path": "timestamp"
      }
    ]
  },
  "pagination": {
    "type": "api_cursor",
    "cursor_path": "continue.sroffset",
    "cursor_parameter": "sroffset",
    "stop_conditions": [
      "max_pages",
      "max_records",
      "missing_continuation"
    ]
  },
  "validation": {
    "minimum_record_coverage": 0.9,
    "unique_by": [
      "page_id"
    ]
  },
  "field_mappings": {
    "canonical_entity": "article",
    "output": {
      "title": "title",
      "source_url": "page_id",
      "summary": "snippet",
      "published_at": "last_edited"
    }
  },
  "health": {
    "fixture_tests": [
      "fixtures/wikipedia/search.json"
    ],
    "expected": {
      "minimum_records": 3,
      "required_field_coverage": 0.95
    },
    "live_check": {
      "enabled": false,
      "only_when_permitted": true
    }
  }
}