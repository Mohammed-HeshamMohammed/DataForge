{
  "id": "gleif.lei_records",
  "version": "1.0.0",
  "display_name": "GLEIF: legal entities",
  "page_type": "api_collection",
  "description": "Searches GLEIF's public LEI data API for legal entities and follows JSON:API next links.",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-03-01",
  "provider": { "name": "GLEIF", "url": "https://www.gleif.org/en/lei-data/gleif-api" },
  "category": "open_data",
  "policy": {
    "collection_basis": "public_api",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "public_registry"
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 1000,
    "max_pages_default": 100,
    "max_records_default": 5000,
    "max_duration_seconds": 3600
  },
  "url_scope": { "allowed_hosts": ["api.gleif.org"], "allowed_path_patterns": ["^/api/v1/lei-records"] },
  "strategy": { "preferred": "api", "allowed": ["api"] },
  "request": {
    "url_template": "https://api.gleif.org/api/v1/lei-records?filter[entity.legalName]={{query}}&page[size]={{limit}}",
    "limit_variable": "limit",
    "variables": {
      "query": { "type": "string", "required": true, "max_length": 300 },
      "limit": { "type": "integer", "default": 50, "minimum": 1, "maximum": 200 }
    }
  },
  "pagination": { "type": "next_link", "next_path": "links.next" },
  "extraction": {
    "item_path": "data",
    "fields": [
      { "key": "lei", "type": "string", "required": true, "path": "id" },
      { "key": "legal_name", "type": "string", "required": true, "path": "attributes.entity.legalName.name" },
      { "key": "jurisdiction", "type": "string", "path": "attributes.entity.jurisdiction" },
      { "key": "category", "type": "string", "path": "attributes.entity.category" },
      { "key": "status", "type": "string", "path": "attributes.entity.status" }
    ]
  },
  "validation": { "minimum_record_coverage": 0.7, "unique_by": ["lei"] },
  "health": {
    "fixture_tests": ["fixtures/research/gleif.json"],
    "expected": { "minimum_records": 2 }
  }
}
