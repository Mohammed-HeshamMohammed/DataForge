{
  "id": "generic.feed",
  "version": "1.0.0",
  "display_name": "RSS / Atom feed",
  "page_type": "feed",
  "description": "One record per feed entry (title, link, published date, author, summary).",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-03-01",
  "provider": {
    "name": "Generic"
  },
  "category": "generic",
  "policy": {
    "collection_basis": "public_html",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "unknown",
    "notes": "Use only for data you are authorized to collect and process."
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 2000,
    "max_pages_default": 50,
    "max_records_default": 1000,
    "max_duration_seconds": 1800
  },
  "url_scope": {
    "allowed_hosts": [],
    "user_supplied_host": true,
    "allowed_path_patterns": []
  },
  "strategy": {
    "preferred": "http",
    "allowed": [
      "http"
    ],
    "prohibited_escalations": [
      "access_denied",
      "captcha",
      "login_required",
      "robots_disallowed"
    ]
  },
  "pagination": {
    "type": "none"
  },
  "discovery": {
    "mode": "feed",
    "feed": {
      "records": true
    }
  },
  "extraction": {
    "mode": "selectors",
    "fields": [
      {
        "key": "title",
        "type": "string",
        "required": true,
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "link",
        "type": "url"
      },
      {
        "key": "published",
        "type": "string"
      },
      {
        "key": "author",
        "type": "string"
      },
      {
        "key": "summary",
        "type": "string",
        "transforms": [
          "collapse_whitespace"
        ]
      },
      {
        "key": "id",
        "type": "string"
      }
    ]
  },
  "validation": {
    "unique_by": [
      "link"
    ]
  },
  "health": {
    "fixture_tests": [
      "fixtures/generic/feed.xml"
    ],
    "expected": {
      "minimum_records": 3
    }
  }
}
