{
  "id": "generic.json_api",
  "version": "1.0.0",
  "display_name": "Generic JSON/API",
  "page_type": "api_collection",
  "description": "One record per object in a JSON array from a public or authorized endpoint.",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-03-01",
  "provider": {
    "name": "Generic"
  },
  "category": "generic",
  "policy": {
    "collection_basis": "public_api",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "unknown",
    "notes": "Use only for data you are authorized to collect and process."
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 2000,
    "max_pages_default": 10,
    "max_records_default": 500,
    "max_duration_seconds": 900
  },
  "url_scope": {
    "allowed_hosts": [],
    "user_supplied_host": true,
    "allowed_path_patterns": []
  },
  "strategy": {
    "preferred": "api",
    "allowed": [
      "api"
    ]
  },
  "extraction": {
    "item_path": "items",
    "fields": [
      {
        "key": "id",
        "type": "string",
        "required": true,
        "path": "id"
      },
      {
        "key": "name",
        "type": "string",
        "path": "name",
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "url",
        "type": "url",
        "path": "url"
      }
    ]
  },
  "pagination": {
    "type": "api_cursor",
    "cursor_path": "next_cursor",
    "cursor_parameter": "cursor"
  },
  "validation": {
    "minimum_record_coverage": 0.7,
    "unique_by": [
      "id"
    ]
  },
  "field_mappings": {
    "canonical_entity": "custom",
    "output": {
      "sku_or_id": "id",
      "name": "name",
      "source_url": "url"
    }
  },
  "health": {
    "fixture_tests": [
      "fixtures/generic/api.json"
    ],
    "expected": {
      "minimum_records": 2
    }
  }
}