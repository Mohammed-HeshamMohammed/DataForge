{
  "id": "generic.listings",
  "version": "1.0.0",
  "display_name": "Listings (built-in collector)",
  "page_type": "category_listing",
  "description": "One record per listing on real-estate search pages (Zillow, Trulia, HAR, Realtor.com, Redfin and other listing sites), read in Scrape Studio from the page's own data, the results the site loads while you browse, or its repeated price cards. Agent names and contact details are not collected.",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-04-01",
  "provider": {
    "name": "Generic"
  },
  "category": "generic",
  "policy": {
    "collection_basis": "public_html",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "limited",
    "notes": "Listing facts only: agent and contact fields are skipped and phone numbers and e-mail addresses are removed from free text. Use only for data you are authorized to collect and process."
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 8000,
    "max_pages_default": 200,
    "max_records_default": 50000,
    "max_duration_seconds": 14400
  },
  "url_scope": {
    "allowed_hosts": [],
    "user_supplied_host": true,
    "allowed_path_patterns": []
  },
  "strategy": {
    "preferred": "webview",
    "allowed": [
      "webview"
    ],
    "prohibited_escalations": [
      "access_denied",
      "captcha",
      "login_required",
      "robots_disallowed"
    ]
  },
  "extraction": {
    "mode": "collector",
    "collector": "listings",
