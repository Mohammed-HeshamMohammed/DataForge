{
  "id": "generic.oai_pmh",
  "version": "1.0.0",
  "display_name": "OAI-PMH research repository",
  "page_type": "research_repository",
  "description": "Harvests Dublin Core or another exposed metadata format from an OAI-PMH endpoint, following opaque resumption tokens.",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-03-01",
  "provider": { "name": "Generic OAI-PMH" },
  "category": "research",
  "policy": {
    "collection_basis": "public_api",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "unknown"
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 1000,
    "max_pages_default": 200,
    "max_records_default": 10000,
    "max_duration_seconds": 7200
  },
  "url_scope": {
    "allowed_hosts": [],
    "user_supplied_host": true,
    "allowed_path_patterns": []
  },
  "strategy": { "preferred": "http", "allowed": ["http"] },
  "request": {
    "variables": {
      "metadata_prefix": { "type": "string", "required": true, "default": "oai_dc", "pattern": "[A-Za-z0-9_.-]+" },
      "set": { "type": "string", "required": false, "max_length": 300 },
      "from": { "type": "string", "required": false, "pattern": "[0-9TZ:.-]+" },
      "until": { "type": "string", "required": false, "pattern": "[0-9TZ:.-]+" }
    }
  },
  "discovery": { "mode": "oai_pmh", "oai_pmh": { "verb": "ListRecords" } },
  "pagination": { "type": "none" },
  "extraction": { "mode": "selectors", "fields": [] },
  "validation": { "minimum_record_coverage": 0.5, "unique_by": ["identifier"] },
  "health": {
    "fixture_tests": ["fixtures/research/oai-pmh.xml"],
    "expected": { "minimum_records": 2 }
  }
}
