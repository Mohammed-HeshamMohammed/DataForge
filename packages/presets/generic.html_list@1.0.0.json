{
  "id": "generic.html_list",
  "version": "1.0.0",
  "display_name": "Generic HTML List",
  "page_type": "category_listing",
  "description": "One record per repeated card on a permitted HTML page. Edit the selectors to fit the page, then test.",
  "status": "deprecated",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-03-01",
  "provider": {
    "name": "Generic"
  },
  "category": "generic",
  "policy": {
    "collection_basis": "public_html",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "unknown",
    "notes": "Use only for data you are authorized to collect and process."
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 2000,
    "max_pages_default": 10,
    "max_records_default": 500,
    "max_duration_seconds": 900
  },
  "url_scope": {
    "allowed_hosts": [],
    "user_supplied_host": true,
    "allowed_path_patterns": []
  },
  "strategy": {
    "preferred": "http",
    "allowed": [
      "http"
    ]
  },
  "extraction": {
    "record_root": {
      "css": "article"
    },
    "fields": [
      {
        "key": "title",
        "type": "string",
        "required": true,
        "selectors": [
          {
            "css": "h2"
          },
          {
            "css": "h3"
          },
          {
            "css": "a"
          }
        ],
        "transforms": [
          "trim",
          "collapse_whitespace"
        ],
        "validate": {
          "min_length": 2
        }
      },
      {
        "key": "link",
        "type": "url",
        "required": false,
        "selectors": [
          {
            "css": "a::attr(href)"
          }
        ],
        "transforms": [
          "to_absolute_url"
        ]
      }
    ]
  },
  "pagination": {
    "type": "next_link",
    "next": {
      "css": "a[rel=next]::attr(href)"
    },
    "stop_conditions": [
      "max_pages",
      "max_records",
      "repeated_canonical_url",
      "no_new_records"
    ]
  },
  "validation": {
    "minimum_record_coverage": 0.7,
    "unique_by": [
      "link"
    ]
  },
  "field_mappings": {
    "canonical_entity": "article",
    "output": {
      "title": "title",
      "source_url": "link"
    }
  },
  "health": {
    "fixture_tests": [
      "fixtures/generic/html-list.html"
    ],
    "expected": {
      "minimum_records": 2
    }
  },
  "successor": "generic.html_list@1.1.0"
}