{
  "id": "wikidata.sparql",
  "version": "1.0.0",
  "display_name": "Wikidata: SPARQL query",
  "page_type": "api_collection",
  "description": "Read-only SPARQL SELECT against the Wikidata Query Service. LIMIT is enforced from the record cap; queries time out after 60 seconds.",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-03-01",
  "provider": {
    "name": "Wikidata"
  },
  "category": "open_data",
  "policy": {
    "collection_basis": "public_api",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "unknown",
    "notes": "Use only for data you are authorized to collect and process."
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 1000,
    "max_pages_default": 1,
    "max_records_default": 10000,
    "max_duration_seconds": 120
  },
  "url_scope": {
    "allowed_hosts": [
      "query.wikidata.org"
    ],
    "allowed_path_patterns": []
  },
  "strategy": {
    "preferred": "api",
    "allowed": [
      "api"
    ]
  },
  "pagination": {
    "type": "none"
  },
  "requires_contact_user_agent": true,
  "validation": {
    "unique_by": []
  },
  "health": {
    "fixture_tests": [
      "fixtures/open_data/wikidata.json"
    ],
    "expected": {
      "minimum_records": 2
    }
  },
  "request": {
    "method": "GET",
    "url_template": "https://query.wikidata.org/sparql?format=json&query={{query}}",
    "accept": "application/sparql-results+json",
    "variables": {
      "query": {
        "type": "sparql",
        "required": true
      }
    }
  },
  "extraction": {
    "item_path": "results.bindings",
    "capture_all": true,
    "fields": []
  }
}
