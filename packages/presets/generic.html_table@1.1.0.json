{
  "id": "generic.html_table",
  "version": "1.1.0",
  "display_name": "Generic Table",
  "page_type": "table",
  "description": "One record per data row of a public HTML table.",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-03-01",
  "provider": {
    "name": "Generic"
  },
  "category": "generic",
  "policy": {
    "collection_basis": "public_html",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "unknown",
    "notes": "Use only for data you are authorized to collect and process."
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 2000,
    "max_pages_default": 10,
    "max_records_default": 500,
    "max_duration_seconds": 900
  },
  "url_scope": {
    "allowed_hosts": [],
    "user_supplied_host": true,
    "allowed_path_patterns": []
  },
  "strategy": {
    "preferred": "http",
    "allowed": [
      "http",
      "webview"
    ],
    "webview_only_if": [
      "initial_response_lacks_required_result_cards"
    ],
    "prohibited_escalations": [
      "access_denied",
      "captcha",
      "login_required",
      "robots_disallowed"
    ]
  },
  "extraction": {
    "record_root": {
      "css": "table tr:has(td)"
    },
    "fields": [
      {
        "key": "column_1",
        "type": "string",
        "required": true,
        "selectors": [
          {
            "css": "td:nth-of-type(1)"
          }
        ],
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "column_2",
        "type": "string",
        "selectors": [
          {
            "css": "td:nth-of-type(2)"
          }
        ],
        "transforms": [
          "trim"
        ]
      },
      {
        "key": "column_3",
        "type": "string",
        "selectors": [
          {
            "css": "td:nth-of-type(3)"
          }
        ],
        "transforms": [
          "trim"
        ]
      }
    ],
    "interactive_builder": {
      "allow_element_picker": true,
      "allowed_attributes": [
        "href",
        "src",
        "alt",
        "title",
        "datetime",
        "aria-label",
        "data-testid"
      ],
      "allow_selector_editing": true,
      "require_successful_test_run_before_full_run": true
    }
  },
  "pagination": {
    "type": "none"
  },
  "validation": {
    "minimum_record_coverage": 0.7,
    "unique_by": []
  },
  "field_mappings": {
    "canonical_entity": "custom",
    "output": {}
  },
  "health": {
    "fixture_tests": [
      "fixtures/generic/html-table.html"
    ],
    "expected": {
      "minimum_records": 2
    }
  }
}