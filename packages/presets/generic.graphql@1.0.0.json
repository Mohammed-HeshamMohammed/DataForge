{
  "id": "generic.graphql",
  "version": "1.0.0",
  "display_name": "Generic GraphQL API",
  "page_type": "graphql_collection",
  "description": "Run a read-only GraphQL query against an endpoint you are authorized to use.",
  "status": "active",
  "owner": "dataforge-core",
  "category": "generic",
  "policy": { "collection_basis": "public_api", "requires_user_authorization_acknowledgement": true, "robots_policy": "respect", "authentication": "forbidden", "captcha_or_access_challenge": "stop", "paywall_or_rate_limit": "stop", "personal_data_classification": "unknown" },
  "request_limits": { "max_concurrency": 1, "min_delay_ms": 1000, "max_pages_default": 1, "max_records_default": 1000, "max_duration_seconds": 300 },
  "url_scope": { "allowed_hosts": [], "user_supplied_host": true, "allowed_path_patterns": [] },
  "strategy": { "preferred": "api", "allowed": ["api"] },
  "request": {
    "method": "POST",
    "content_type": "application/json",
    "accept": "application/json",
    "body_template": "{\"query\":\"{{query}}\"}",
    "variables": { "query": { "type": "graphql", "required": true, "max_length": 20000 } }
  },
  "pagination": { "type": "none" },
  "extraction": { "item_path": "data.*", "capture_all": true, "fields": [] },
  "validation": { "minimum_record_coverage": 0.0, "unique_by": [] },
  "health": { "fixture_tests": ["fixtures/generic/graphql.json"], "expected": { "minimum_records": 2 } }
}
