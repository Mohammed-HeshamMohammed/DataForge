{
  "id": "crossref.works",
  "version": "1.0.0",
  "display_name": "Crossref: scholarly works",
  "page_type": "api_collection",
  "description": "Searches Crossref's public scholarly metadata API and follows cursor pagination.",
  "status": "active",
  "owner": "dataforge-core",
  "maintenance_review_date": "2027-03-01",
  "provider": { "name": "Crossref", "url": "https://www.crossref.org/documentation/retrieve-metadata/rest-api/" },
  "category": "research",
  "policy": {
    "collection_basis": "public_api",
    "requires_user_authorization_acknowledgement": true,
    "robots_policy": "respect",
    "authentication": "forbidden",
    "captcha_or_access_challenge": "stop",
    "paywall_or_rate_limit": "stop",
    "personal_data_classification": "public_metadata"
  },
  "request_limits": {
    "max_concurrency": 1,
    "min_delay_ms": 1000,
    "max_pages_default": 100,
    "max_records_default": 10000,
    "max_duration_seconds": 3600
  },
  "url_scope": { "allowed_hosts": ["api.crossref.org"], "allowed_path_patterns": ["^/works"] },
  "strategy": { "preferred": "api", "allowed": ["api"] },
  "request": {
    "url_template": "https://api.crossref.org/works?query={{query}}&rows={{limit}}&cursor=*",
    "limit_variable": "limit",
    "variables": {
      "query": { "type": "string", "required": true, "max_length": 500 },
      "limit": { "type": "integer", "default": 100, "minimum": 1, "maximum": 1000 }
    }
  },
  "pagination": { "type": "api_cursor", "cursor_path": "message.next-cursor", "cursor_parameter": "cursor" },
  "extraction": {
    "item_path": "message.items",
    "capture_all": true,
    "fields": [
      { "key": "doi", "type": "string", "required": true, "path": "DOI" },
      { "key": "title", "type": "string", "path": "title" },
      { "key": "publisher", "type": "string", "path": "publisher" },
      { "key": "type", "type": "string", "path": "type" },
      { "key": "url", "type": "url", "path": "URL" }
    ]
  },
  "validation": { "minimum_record_coverage": 0.7, "unique_by": ["doi"] },
  "health": {
    "fixture_tests": ["fixtures/research/crossref.json"],
    "expected": { "minimum_records": 2 }
  }
}
