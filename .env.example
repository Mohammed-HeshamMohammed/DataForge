# Copy to .env and edit. Every setting is optional; these are the defaults.

DATAFORGE_ENVIRONMENT=development
DATAFORGE_LOG_LEVEL=INFO
DATAFORGE_LOG_JSON=false

# Matching
DATAFORGE_MATCH_THRESHOLD=0.85
DATAFORGE_BLOCKING_KEY_LENGTH=4

# Scraping — identify yourself honestly and stay polite
DATAFORGE_SCRAPE_DELAY_SECONDS=1.0
DATAFORGE_SCRAPE_MAX_RETRIES=3
DATAFORGE_SCRAPE_RESPECT_ROBOTS=true

# Browser automation
DATAFORGE_SELENIUM_BROWSER=chrome
DATAFORGE_SELENIUM_HEADLESS=true
# DATAFORGE_SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub

# Web
DATAFORGE_WEB_HOST=127.0.0.1
DATAFORGE_WEB_PORT=8000
